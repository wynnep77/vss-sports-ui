# NVIDIA VSS Blueprint Configuration
# Copy this file to .env and fill in your values

# Network Configuration
HOST_IP=<your-server-ip>
EXTERNAL_IP=<your-server-ip>
INTERNAL_IP=<your-server-ip>

# NVIDIA NGC API Key
# Get your API key from: https://build.nvidia.com/ or https://org.ngc.nvidia.com/setup/api-keys
NGC_API_KEY=<your-ngc-api-key>

# Service Ports
LLM_PORT=30081
VLM_PORT=30082
VST_PORT=30888
VSS_AGENT_PORT=8000

# Service URLs (derived from HOST_IP and ports)
LLM_BASE_URL=http://${HOST_IP}:${LLM_PORT}
VLM_BASE_URL=http://${HOST_IP}:${VLM_PORT}
VST_INTERNAL_URL=http://${HOST_IP}:${VST_PORT}
VST_EXTERNAL_URL=http://${HOST_IP}:${VST_PORT}

# VSS Apps Directory
VSS_APPS_DIR=/home/demouser/vss-deployment/video-search-and-summarization/services/ui

# Phoenix Telemetry (optional)
PHOENIX_ENDPOINT=http://${HOST_IP}:6006

# Additional Configuration
# Add any other required environment variables here
